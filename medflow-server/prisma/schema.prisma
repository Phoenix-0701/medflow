// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum TriageSeverity {
  GREEN   // Nhẹ, tự chăm sóc
  YELLOW  // Cần gặp bác sĩ chuyên khoa
  RED     // Khẩn cấp, cấp cứu
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// -----------------------------------------------------------------------------
// CORE HEALTHCARE MODELS (MedFlow NestJS Backend)
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  cognitoId String   @unique // ID trả về từ AWS Cognito
  email     String   @unique
  fullName  String
  phone     String?
  avatarUrl String?
  role      Role     @default(PATIENT)
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ 1-1
  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
}

model DoctorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  specialty         String   // VD: "Nội khoa", "Da liễu"
  department        String   // VD: "Khoa Khám Bệnh"
  bio               String?  // Tiểu sử chuyên môn
  yearsOfExperience Int?     // Số năm kinh nghiệm
  licenseNumber     String?  // Số giấy phép hành nghề
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Quan hệ 1-n
  availabilities DoctorAvailability[]
  appointments   Appointment[]
  leaves         DoctorLeave[]
  
  // Quan hệ 1-1
  weeklySchedule DoctorWeeklySchedule?
}

model PatientProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  dateOfBirth    DateTime?
  gender         String?
  bloodType      String?
  weight         Float?
  height         Float?
  allergies      String?  
  medicalHistory String?  // Tiền sử bệnh
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ 1-n
  triageSessions AiTriageSession[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

// -----------------------------------------------------------------------------
// AI TRIAGE & APPOINTMENTS
// -----------------------------------------------------------------------------

model AiTriageSession {
  id                   String         @id @default(uuid())
  patientId            String
  sessionId            String?        @map("session_id") // Định danh luồng chat AI (khớp với ChatHistory)
  symptomsSummary      String
  severity             TriageSeverity
  recommendedSpecialty String?
  aiReport             String         // Báo cáo tóm tắt chuẩn y khoa
  
  createdAt            DateTime       @default(now())

  patient              PatientProfile @relation(fields: [patientId], references: [id])
  
  // Quan hệ 1-1: Một phiên tư vấn có thể tạo ra tối đa 1 lịch khám
  appointment          Appointment?
}

model DoctorAvailability {
  id        String   @id @default(uuid())
  doctorId  String
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  
  @@index([doctorId, startTime])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  triageSessionId String?           @unique
  
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(PENDING)
  cancelReason    String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  diagnosis       String?           @db.Text // Kết luận chẩn đoán (Dùng @db.Text để lưu chuỗi dài)
  
  rating          Int?              // Điểm đánh giá (1-5)
  reviewText      String?           @db.Text // Nội dung đánh giá

  prescription    String?           @db.Text // Đơn thuốc / Hướng dẫn điều trị

  patient         PatientProfile    @relation(fields: [patientId], references: [id])
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id])
  triageSession   AiTriageSession?  @relation(fields: [triageSessionId], references: [id])
  
  // Sau khi khám xong sẽ tạo hồ sơ này
  medicalRecord   MedicalRecord?
}

// -----------------------------------------------------------------------------
// MEDICAL RECORDS
// -----------------------------------------------------------------------------

model MedicalRecord {
  id               String   @id @default(uuid())
  appointmentId    String   @unique
  patientId        String
  
  clinicalFindings String   // Ghi chú lâm sàng
  finalDiagnosis   String   // Chẩn đoán chốt
  prescription     String?  // Kê đơn
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment      Appointment    @relation(fields: [appointmentId], references: [id])
  patient          PatientProfile @relation(fields: [patientId], references: [id])
}

// -----------------------------------------------------------------------------
// AVAILABILITY & SETTINGS
// -----------------------------------------------------------------------------

model DoctorWeeklySchedule {
  id         String   @id @default(uuid())
  doctorId   String   @unique
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  monday     Json?
  tuesday    Json?
  wednesday  Json?
  thursday   Json?
  friday     Json?
  saturday   Json?
  sunday     Json?
}

model DoctorLeave {
  id         String   @id @default(uuid())
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  
  startDate  DateTime
  endDate    DateTime
  reason     String
  
  createdAt  DateTime @default(now())
}

// -----------------------------------------------------------------------------
// AI CHAT HISTORY & INTERNAL AI/CHAINLIT MODELS (Managed by Python / LangChain)
// -----------------------------------------------------------------------------

model ChatHistory {
  id         Int      @id @default(autoincrement())
  sessionId  String   @map("session_id") @db.Uuid
  message    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([sessionId], map: "idx_chat_history_session_id")
  @@map("chat_history")
}

model elements {
  id          String  @id @db.Uuid
  threadId    String? @db.Uuid
  type        String?
  url         String?
  chainlitKey String?
  name        String
  display     String?
  objectKey   String?
  size        String?
  page        Int?
  language    String?
  forId       String? @db.Uuid
  mime        String?

  @@ignore
}

model feedbacks {
  id       String  @id @db.Uuid
  forId    String  @db.Uuid
  threadId String  @db.Uuid
  value    Int
  comment  String?

  @@ignore
}

model langchain_pg_collection {
  uuid                   String                   @id @db.Uuid
  name                   String                   @unique @db.VarChar
  cmetadata              Json?                    @db.Json
  langchain_pg_embedding langchain_pg_embedding[]

  @@ignore
}

model langchain_pg_embedding {
  id                      String                   @id @db.VarChar
  collection_id           String?                  @db.Uuid
  embedding               Unsupported("vector")?
  document                String?                  @db.VarChar
  cmetadata               Json?
  langchain_pg_collection langchain_pg_collection? @relation(fields: [collection_id], references: [uuid], onDelete: Cascade, onUpdate: NoAction)

  @@index([cmetadata(ops: JsonbPathOps)], map: "ix_cmetadata_gin", type: Gin)
  @@ignore
}

model steps {
  id              String   @id @db.Uuid
  name            String
  type            String
  threadId        String   @db.Uuid
  parentId        String?  @db.Uuid
  disableFeedback Boolean  @default(false)
  streaming       Boolean
  waitForAnswer   Boolean?
  isError         Boolean?
  metadata        Json?
  tags            String[]
  input           String?
  output          String?
  createdAt       String?
  start           String?
  end             String?
  generation      Json?
  showInput       String?
  language        String?
  indent          Int?

  @@ignore
}

model threads {
  id             String   @id @db.Uuid
  createdAt      String?
  name           String?
  userId         String?  @db.Uuid
  userIdentifier String?
  tags           String[]
  metadata       Json?
  users          users?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@ignore
}

model users {
  id         String    @id @db.Uuid
  identifier String    @unique
  metadata   Json
  createdAt  String?
  threads    threads[]

  @@ignore
}
